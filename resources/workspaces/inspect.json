                "panel": "outliner"
              }
            ]
          },
          {
            "tabs": [
              {
                "panel": "attributes"
              }
            ]
          }
        ],
        "maxWidth": 420
      },
      {
        "split": "vertical",
        "sizes": [
          0.65,
          0.35
        ],
        "items": [
          {
            "tabs": [
              {
                "panel": "viewport"
              }
            ]
          },
          {
            "tabs": [
              {
                "panel": "usda"
              }
            ]
          }
        ]
      },
      {
        "tabs": [
          {
            "panel": "schemas"
          }
        ],
        "maxWidth": 560
      }
    ]
