{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/olihey/usdcc/resources/workspaces/workspace.schema.json",
  "title": "usdcc workspace",
  "description": "A predefined layout of usdcc's view panels (docs/WORKSPACES.md section 3). The app doesn't need this file to read workspaces; it's for editors.",
  "type": "object",
  "required": ["format", "version", "name", "layout"],
  "properties": {
    "format": { "const": "usdcc-workspace" },
    "version": { "type": "integer", "minimum": 1, "maximum": 1 },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$", "description": "Defaults to the file name without .json." },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "group": { "type": "string", "description": "The heading it's listed under in the workspace menu." },
    "order": { "type": "integer", "default": 1000, "description": "Menu order, lowest first; also orders the groups." },
    "fitOnSwitch": {
      "description": "Fit every viewport placed when switching to it. true means \"selection\".",
      "oneOf": [{ "type": "boolean" }, { "enum": ["stage", "selection", "none"] }]
    },
    "sidePanels": {
      "type": "object",
      "description": "Side panel name (Log, Script Editor, Plugins, ...) to its state; others are left as they are.",
      "additionalProperties": { "enum": ["shown", "collapsed", "hidden"] }
    },
    "layout": { "$ref": "#/$defs/node" }
  },
  "$defs": {
    "node": { "oneOf": [{ "$ref": "#/$defs/split" }, { "$ref": "#/$defs/area" }] },
    "split": {
      "type": "object",
      "required": ["split", "items"],
      "properties": {
        "split": { "enum": ["horizontal", "vertical"], "description": "horizontal: side by side; vertical: stacked." },
        "sizes": { "type": "array", "items": { "type": "number", "minimum": 0 }, "description": "Shares, normalised." },
        "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/node" } }
      }
    },
    "area": {
      "type": "object",
      "required": ["tabs"],
      "properties": {
        "tabs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/panel" } },
        "current": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "string" }] }
      }
    },
    "panel": {
      "type": "object",
      "required": ["panel"],
      "properties": {
        "panel": {
          "type": "string",
          "description": "A view panel type: viewport, outliner, attributes, layers, usda, materialEditor, dependencies, or a plugin's."
        },
        "title": { "type": "string" },
        "optionsPinned": { "type": "boolean" },
        "state": { "type": "object", "description": "Handed to the panel's restoreSessionState() when the workspace makes it." },
        "stage": {
          "enum": ["each", "current"],
          "description": "Viewports: each (one per open stage; exactly one such entry) or current (follows the current stage)."
        },
        "camera": { "$ref": "#/$defs/camera" }
      }
    },
    "camera": {
      "type": "object",
      "properties": {
        "view": { "enum": ["persp", "top", "bottom", "front", "back", "right", "left"] },
        "projection": { "enum": ["perspective", "orthographic"] },
        "fit": { "oneOf": [{ "type": "boolean" }, { "enum": ["stage", "selection", "none"] }] },
        "yaw": { "type": "number" },
        "pitch": { "type": "number" },
        "fov": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 180 },
        "target": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
        "distance": { "type": "number", "exclusiveMinimum": 0 },
        "size": { "type": "number", "exclusiveMinimum": 0 },
        "path": { "type": "string", "description": "Later: a UsdGeomCamera to look through, or \"first\". Read and ignored for now." }
      }
    }
  }
}
