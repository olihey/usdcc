diff --git a/plugin/hd_moonray/RendererPlugin.cc b/plugin/hd_moonray/RendererPlugin.cc
index b470c5d..4263ca4 100644
--- a/plugin/hd_moonray/RendererPlugin.cc
+++ b/plugin/hd_moonray/RendererPlugin.cc
@@ -7,10 +7,44 @@
 #include <pxr/imaging/hd/rendererPlugin.h>
 #include <pxr/imaging/hd/rendererPluginRegistry.h>
 
+#include <cstdlib>
 #include <iostream>
+#include <sstream>
+#include <string>
+#include <unistd.h>
 
 PXR_NAMESPACE_OPEN_SCOPE // this does not work unless inside the pxr namespace
 
+namespace {
+
+// Whether one of a search path's folders has the file.
+bool isInPath(const char* variable, const char* file, int mode)
+{
+    const char* value = std::getenv(variable);
+    std::istringstream folders(value ? value : "");
+    for (std::string folder; std::getline(folders, folder, ':');) {
+        if (!folder.empty() && access((folder + "/" + file).c_str(), mode) == 0) return true;
+    }
+    return false;
+}
+
+// A session needs its definition, without which ArrasSettings' constructor throws, and the
+// program that runs MoonRay, without which connecting is tried again and again.
+bool arrasIsThere(std::string* reasonWhyNot)
+{
+    const char* reason = nullptr;
+    if (!isInPath("ARRAS_SESSION_PATH", "hd_single.sessiondef", R_OK) ||
+        !isInPath("ARRAS_SESSION_PATH", "hd_multi.sessiondef", R_OK)) {
+        reason = "ARRAS_SESSION_PATH has no folder with MoonRay's session definitions";
+    } else if (!isInPath("PATH", "execComp", X_OK)) {
+        reason = "Arras's program execComp isn't on PATH";
+    }
+    if (reason && reasonWhyNot) *reasonWhyNot = reason;
+    return !reason;
+}
+
+} // namespace
+
 class HdMoonrayRendererPlugin final : public pxr::HdRendererPlugin {
 public:
     HdMoonrayRendererPlugin() {}
@@ -34,7 +68,12 @@ public:
     void DeleteRenderDelegate(pxr::HdRenderDelegate *renderDelegate) override {
         delete renderDelegate;
