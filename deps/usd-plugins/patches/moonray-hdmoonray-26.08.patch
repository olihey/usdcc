diff --git a/plugin/common/Environment.cc b/plugin/common/Environment.cc
new file mode 100644
index 0000000..3a91be7
--- /dev/null
+++ b/plugin/common/Environment.cc
@@ -0,0 +1,65 @@
+// Copyright 2026 usdcc contributors
+// SPDX-License-Identifier: Apache-2.0
+//
+// Lets a MoonRay install find its own parts when the plugin is loaded from it,
+// without a setup script: the shader DSOs, Arras's session definitions and
+// its program. Each is set only when the environment doesn't set it already.
+// The install is laid out as
+//
+//     <root>/plugin/<this plugin>.so
+//     <root>/rdl2dso, <root>/sessions, <root>/bin/execComp
+//
+// It runs when the plugin library is loaded, before any renderer is created.
+
+#include <cstdlib>
+#include <dlfcn.h>
+#include <string>
+#include <sys/stat.h>
+
+namespace {
+
+bool isDir(const std::string& path)
+{
+    struct stat info;
+    return stat(path.c_str(), &info) == 0 && S_ISDIR(info.st_mode);
+}
+
+std::string parent(const std::string& path)
+{
+    const std::string::size_type slash = path.rfind('/');
+    return slash == std::string::npos ? std::string() : path.substr(0, slash);
+}
+
+void setDefault(const char* name, const std::string& folder)
+{
+    const char* current = std::getenv(name);
+    if ((!current || !*current) && isDir(folder)) setenv(name, folder.c_str(), 1);
+}
+
+struct MoonrayEnvironment
+{
+    MoonrayEnvironment()
+    {
+        Dl_info info;
+        if (!dladdr(reinterpret_cast<void*>(&isDir), &info) || !info.dli_fname) return;
+        char* resolved = realpath(info.dli_fname, nullptr);
+        if (!resolved) return;
+        const std::string root = parent(parent(resolved));
+        std::free(resolved);
+        if (root.empty()) return;
+
+        setDefault("RDL2_DSO_PATH", root + "/rdl2dso");
+        setDefault("ARRAS_SESSION_PATH", root + "/sessions");
+        // execComp is looked for on PATH, by this process and by the session it starts.
+        const std::string bin = root + "/bin";
+        const char* path = std::getenv("PATH");
+        const std::string current = path ? path : "";
+        if (isDir(bin) && (":" + current + ":").find(":" + bin + ":") == std::string::npos) {
+            setenv("PATH", current.empty() ? bin.c_str() : (bin + ":" + current).c_str(), 1);
+        }
+    }
+};
+
+const MoonrayEnvironment environment;
+
+} // namespace
diff --git a/plugin/common/ImplicitSurfaceSceneIndexPlugin.cc b/plugin/common/ImplicitSurfaceSceneIndexPlugin.cc
new file mode 100644
index 0000000..b316fa0
--- /dev/null
+++ b/plugin/common/ImplicitSurfaceSceneIndexPlugin.cc
@@ -0,0 +1,65 @@
+//
+// Copyright 2022 Pixar
+//
+// Licensed under the terms set forth in the LICENSE.txt file available at
+// https://openusd.org/license.
+//
+// Adapted for hdMoonray from OpenUSD's hdEmbree
+// (pxr/imaging/plugin/hdEmbree/delegate/implicitSurfaceSceneIndexPlugin.cpp).
+//
+// Turns USD's implicit shapes (sphere, cube, cone, cylinder, capsule, plane) into meshes
+// for MoonRay. A Hydra host that feeds the renderer through scene indices, as
+// UsdImagingGLEngine does, hands them over as they are; without this they are not drawn.
+//
+// HDM_PLUGIN_CLASS and HDM_PLUGIN_DISPLAY_NAME come from the plugin's CMakeLists.txt: the
+// class, and the render delegate's displayName in plugInfo.json.
+
+#include <pxr/imaging/hd/retainedDataSource.h>
+#include <pxr/imaging/hd/sceneIndexPlugin.h>
+#include <pxr/imaging/hd/sceneIndexPluginRegistry.h>
+#include <pxr/imaging/hd/tokens.h>
+#include <pxr/imaging/hdsi/implicitSurfaceSceneIndex.h>
+#include <pxr/imaging/hdsi/lightLinkingSceneIndex.h>
+
+#define HDM_STR2(x) #x
+#define HDM_STR(x) HDM_STR2(x)
+
+PXR_NAMESPACE_OPEN_SCOPE
+
+class HDM_PLUGIN_CLASS : public HdSceneIndexPlugin
+{
+public:
+    HDM_PLUGIN_CLASS() = default;
+
+protected:
+    HdSceneIndexBaseRefPtr _AppendSceneIndex(const HdSceneIndexBaseRefPtr& inputScene,
+                                             const HdContainerDataSourceHandle& inputArgs) override
+    {
+        HdDataSourceBaseHandle const toMesh =
+            HdRetainedTypedSampledDataSource<TfToken>::New(HdsiImplicitSurfaceSceneIndexTokens->toMesh);
+        HdSceneIndexBaseRefPtr const meshes = HdsiImplicitSurfaceSceneIndex::New(inputScene, HdRetainedContainerDataSource::New(
+            HdPrimTypeTokens->sphere, toMesh,
+            HdPrimTypeTokens->cube, toMesh,
+            HdPrimTypeTokens->cone, toMesh,
+            HdPrimTypeTokens->cylinder, toMesh,
+            HdPrimTypeTokens->capsule, toMesh,
+            HdPrimTypeTokens->plane, toMesh));
+        // Turns light link collections into the categories that hdMoonray reads.
+        return HdsiLightLinkingSceneIndex::New(meshes, inputArgs);
+    }
+};
+
+TF_REGISTRY_FUNCTION(TfType)
+{
+    HdSceneIndexPluginRegistry::Define<HDM_PLUGIN_CLASS>();
+}
+
+TF_REGISTRY_FUNCTION(HdSceneIndexPlugin)
+{
+    const HdSceneIndexPluginRegistry::InsertionPhase insertionPhase = 0;
+    HdSceneIndexPluginRegistry::GetInstance().RegisterSceneIndexForRenderer(
+        HDM_PLUGIN_DISPLAY_NAME, TfToken(HDM_STR(HDM_PLUGIN_CLASS)), nullptr,
+        insertionPhase, HdSceneIndexPluginRegistry::InsertionOrderAtStart);
+}
+
+PXR_NAMESPACE_CLOSE_SCOPE
