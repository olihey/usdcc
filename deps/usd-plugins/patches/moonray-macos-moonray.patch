diff --git a/lib/rendering/pbr/CMakeLists.txt b/lib/rendering/pbr/CMakeLists.txt
index 3101e16..911d100 100644
--- a/lib/rendering/pbr/CMakeLists.txt
+++ b/lib/rendering/pbr/CMakeLists.txt
@@ -267,13 +267,27 @@ writeSamplingDefinitionsHeader("${headerDefs}") # passing a list requires quotes
 foreach(binFile ${binFiles})
     get_filename_component(baseName ${binFile} NAME_WLE)
     set(objFile sampler/${baseName}.o)
-    set(srcFile sampler/${baseName}.c)
+    set(srcFile ${CMAKE_CURRENT_BINARY_DIR}/sampler/${baseName}.s)
 
     if(IsDarwinPlatform)
+        # Changed by usdcc: by the assembler, as a C compiler takes gigabytes for the
+        # same file written out as an array (xxd -i). Sampler.cc takes the second symbol's
+        # address as the table's end, so it has to be right after it.
+        file(MAKE_DIRECTORY ${CMAKE_CURRENT_BINARY_DIR}/sampler)
+        file(WRITE ${srcFile}
+"    .section __TEXT,__const
+    .globl __binary_${baseName}
+    .globl __binary_${baseName}_len
+    .p2align 6
+__binary_${baseName}:
+    .incbin \"${binFile}\"
+__binary_${baseName}_len:
+    .long 0
+")
         add_custom_command(
             OUTPUT  ${objFile}
             DEPENDS ${binFile}
-            COMMAND xxd -i -n _binary_${baseName} "${binFile}" "${srcFile}" && cc -c "${srcFile}" -o "${objFile}")
+            COMMAND cc -arch arm64 -c "${srcFile}" -o "${objFile}")
     else()
         add_custom_command(
             OUTPUT  ${objFile}
