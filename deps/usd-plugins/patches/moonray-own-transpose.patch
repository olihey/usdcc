+#if !defined(__aarch64__)
+// Changed by usdcc: the 8x8 transposes' shared step, written for usdcc.
+// Transposes the 8x8 matrix whose rows are in 'm', in place. The 128-bit halves
+// go to their places first: after that m[0..3] and m[4..7] are two independent
+// sets of 4x4 matrices, one per lane, and interleaving rows two apart twice
+// transposes each.
+__forceinline void
+transposeRows_8x8(__m256 (&m)[8])
+{
+    __m256 halves[8];
+    for (unsigned i = 0; i < 4; ++i) {
+        halves[i]     = _mm256_permute2f128_ps(m[i], m[i + 4], 0x20);
+        halves[i + 4] = _mm256_permute2f128_ps(m[i], m[i + 4], 0x31);
+    }
+    for (unsigned k = 0; k < 8; k += 4) {
+        const __m256 evenLo = _mm256_unpacklo_ps(halves[k],     halves[k + 2]);
+        const __m256 evenHi = _mm256_unpackhi_ps(halves[k],     halves[k + 2]);
+        const __m256 oddLo  = _mm256_unpacklo_ps(halves[k + 1], halves[k + 3]);
+        const __m256 oddHi  = _mm256_unpackhi_ps(halves[k + 1], halves[k + 3]);
+        m[k]     = _mm256_unpacklo_ps(evenLo, oddLo);
+        m[k + 1] = _mm256_unpackhi_ps(evenLo, oddLo);
+        m[k + 2] = _mm256_unpacklo_ps(evenHi, oddHi);
+        m[k + 3] = _mm256_unpackhi_ps(evenHi, oddHi);
+    }
+}
+#endif
