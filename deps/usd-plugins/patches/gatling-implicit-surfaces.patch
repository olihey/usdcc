diff --git a/src/hdGatling/implicitSurfaceSceneIndexPlugin.cpp b/src/hdGatling/implicitSurfaceSceneIndexPlugin.cpp
new file mode 100644
index 0000000..b95148f
--- /dev/null
+++ b/src/hdGatling/implicitSurfaceSceneIndexPlugin.cpp
@@ -0,0 +1,65 @@
+//
+// Copyright 2022 Pixar
+//
+// Licensed under the terms set forth in the LICENSE.txt file available at
+// https://openusd.org/license.
+//
+// Adapted for hdGatling from OpenUSD's hdEmbree
+// (pxr/imaging/plugin/hdEmbree/delegate/implicitSurfaceSceneIndexPlugin.cpp).
+//
+
+#include "implicitSurfaceSceneIndexPlugin.h"
+
+#include <pxr/imaging/hd/retainedDataSource.h>
+#include <pxr/imaging/hd/sceneIndexPluginRegistry.h>
+#include <pxr/imaging/hd/tokens.h>
+#include <pxr/imaging/hdsi/implicitSurfaceSceneIndex.h>
+
+PXR_NAMESPACE_OPEN_SCOPE
+
+TF_DEFINE_PRIVATE_TOKENS(
+  _tokens,
+  ((sceneIndexPluginName, "HdGatling_ImplicitSurfaceSceneIndexPlugin"))
+);
+
+// The renderer plugin's displayName in plugInfo.json.
+static const char* const _pluginDisplayName = "Gatling";
+
+TF_REGISTRY_FUNCTION(TfType)
+{
+  HdSceneIndexPluginRegistry::Define<HdGatling_ImplicitSurfaceSceneIndexPlugin>();
+}
+
+TF_REGISTRY_FUNCTION(HdSceneIndexPlugin)
+{
+  const HdSceneIndexPluginRegistry::InsertionPhase insertionPhase = 0;
+
+  HdSceneIndexPluginRegistry::GetInstance().RegisterSceneIndexForRenderer(
+    _pluginDisplayName,
+    _tokens->sceneIndexPluginName,
+    /* inputArgs = */ nullptr,
+    insertionPhase,
+    HdSceneIndexPluginRegistry::InsertionOrderAtStart);
+}
+
+HdGatling_ImplicitSurfaceSceneIndexPlugin::HdGatling_ImplicitSurfaceSceneIndexPlugin() = default;
+
+HdSceneIndexBaseRefPtr HdGatling_ImplicitSurfaceSceneIndexPlugin::_AppendSceneIndex(
+  const HdSceneIndexBaseRefPtr& inputScene,
+  const HdContainerDataSourceHandle& inputArgs)
+{
+  HdDataSourceBaseHandle const toMeshSrc =
+    HdRetainedTypedSampledDataSource<TfToken>::New(HdsiImplicitSurfaceSceneIndexTokens->toMesh);
+
+  HdContainerDataSourceHandle const localInputArgs = HdRetainedContainerDataSource::New(
+    HdPrimTypeTokens->sphere, toMeshSrc,
+    HdPrimTypeTokens->cube, toMeshSrc,
+    HdPrimTypeTokens->cone, toMeshSrc,
+    HdPrimTypeTokens->cylinder, toMeshSrc,
+    HdPrimTypeTokens->capsule, toMeshSrc,
+    HdPrimTypeTokens->plane, toMeshSrc);
+
+  return HdsiImplicitSurfaceSceneIndex::New(inputScene, localInputArgs);
+}
+
+PXR_NAMESPACE_CLOSE_SCOPE
diff --git a/src/hdGatling/implicitSurfaceSceneIndexPlugin.h b/src/hdGatling/implicitSurfaceSceneIndexPlugin.h
new file mode 100644
index 0000000..0303468
--- /dev/null
+++ b/src/hdGatling/implicitSurfaceSceneIndexPlugin.h
@@ -0,0 +1,32 @@
+//
+// Copyright 2022 Pixar
+//
+// Licensed under the terms set forth in the LICENSE.txt file available at
+// https://openusd.org/license.
+//
+// Adapted for hdGatling from OpenUSD's hdEmbree
+// (pxr/imaging/plugin/hdEmbree/delegate/implicitSurfaceSceneIndexPlugin.h).
+//
+
+#pragma once
+
+#include <pxr/imaging/hd/sceneIndexPlugin.h>
+#include <pxr/pxr.h>
+
+PXR_NAMESPACE_OPEN_SCOPE
+
+// Turns USD's implicit shapes (sphere, cube, cone, cylinder, capsule, plane) into
+// meshes for Gatling, which only draws meshes. A Hydra host that feeds the
+// renderer through scene indices, as UsdImagingGLEngine does, hands them over
+// as they are; without this they are not drawn at all.
+class HdGatling_ImplicitSurfaceSceneIndexPlugin : public HdSceneIndexPlugin
+{
+public:
+  HdGatling_ImplicitSurfaceSceneIndexPlugin();
+
+protected:
+  HdSceneIndexBaseRefPtr _AppendSceneIndex(const HdSceneIndexBaseRefPtr& inputScene,
+                                           const HdContainerDataSourceHandle& inputArgs) override;
+};
+
+PXR_NAMESPACE_CLOSE_SCOPE
