@@ -0,0 +1,27 @@
+/* Copyright 2022 Pixar
+ *
+ * Licensed under the terms set forth in the LICENSE.txt file available at
+ * https://openusd.org/license.
+ *
+ * Adapted from OpenUSD's hdEmbree (pxr/imaging/plugin/hdEmbree/implicitSurfaceSceneIndexPlugin.h). */
+
+#pragma once
+
+#include <pxr/imaging/hd/sceneIndexPlugin.h>
+#include <pxr/pxr.h>
+
+PXR_NAMESPACE_OPEN_SCOPE
+
+/* Turns USD's implicit shapes (sphere, cube, cone, cylinder, capsule, plane) into meshes for
+ * Cycles, which draws only meshes. A Hydra host that feeds the renderer through scene indices,
+ * as UsdImagingGLEngine does, hands them over as they are; without this they aren't drawn. */
+class HdCycles_ImplicitSurfaceSceneIndexPlugin : public HdSceneIndexPlugin {
+ public:
+  HdCycles_ImplicitSurfaceSceneIndexPlugin();
+
+ protected:
+  HdSceneIndexBaseRefPtr _AppendSceneIndex(const HdSceneIndexBaseRefPtr &inputScene,
+                                           const HdContainerDataSourceHandle &inputArgs) override;
+};
+
+PXR_NAMESPACE_CLOSE_SCOPE
