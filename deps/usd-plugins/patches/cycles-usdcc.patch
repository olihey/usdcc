+ *
+ * Changed for usdcc (https://github.com/olihey/usdcc): a dome light's intensity is not
+ * converted to radiant flux. */
 
 #include "hydra/light.h"
 #include "hydra/session.h"
@@ -92,8 +95,9 @@ void HdCyclesLight::Sync(HdSceneDelegate *sceneDelegate,
       /* Unclear why, but approximately matches Karma. */
       strength *= 4.0f;
     }
-    else {
-      /* Convert from intensity to radiant flux. */
+    else if (_lightType != HdPrimTypeTokens->domeLight) {
+      /* Convert from intensity to radiant flux. Not for a dome light: it becomes the
+       * background, whose strength is radiance, as UsdLux's intensity is. */
       strength *= M_PI_F;
     }
 
