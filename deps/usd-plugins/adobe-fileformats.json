{
  "repository": "https://github.com/adobe/USD-Fileformat-plugins",
  "commit": "6441b97807a59472337f9c3d02df089d45ed1c48",
  "version": "2026.07",
  "patches": ["patches/adobe-fileformats-arm64.patch"],
  "cmake": [
    "-Dpxr_ROOT={usd}",
    "-DUSD_FILEFORMATS_BUILD_TESTS=OFF",
    "-DUSD_FILEFORMATS_ENABLE_FBX=OFF",
    "-DUSD_FILEFORMATS_ENABLE_SBSAR=OFF",
    "-DUSD_FILEFORMATS_ENABLE_DRACO=OFF",
    "-DUSD_FILEFORMATS_ENABLE_INSTALL_PLUGINFO_ROOT=OFF",
    "-DUSD_FILEFORMATS_ENABLE_CXX11_ABI=ON"
  ],
  "platforms": ["win64", "win-arm64", "linux-x64", "linux-arm64", "macos-arm64"],
  "license": "Apache-2.0",
  "set": "standard",
  "check": {
    "plugins": ["usdGltf_plugin", "usdObj_plugin", "usdPly_plugin", "usdStl_plugin", "usdSpz_plugin"],
    "extensions": ["gltf", "glb", "obj", "ply", "stl", "spz"],
    "open": [
      {"file": "test_data/formats/triangle.gltf", "prims": {"Mesh": 1}},
      {"file": "test_data/formats/triangle.obj", "prims": {"Mesh": 1}},
      {"file": "test_data/formats/triangle.ply", "prims": {"Mesh": 1}},
      {"file": "test_data/formats/triangle.stl", "prims": {"Mesh": 1}}
    ]
  }
}
