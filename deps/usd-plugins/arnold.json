{
  "repository": "https://github.com/Autodesk/arnold-usd",
  "commit": "1f022c168ba742df01aad7de57d0c4f2125d080e",
  "version": "7.5.4.0",
  "patches": ["patches/arnold-usd-26.08.patch"],
  "sdks": {
    "arnold": {
      "description": "Arnold SDK 7.5.4 (7.5.4.0 or later) for this platform, from Autodesk Account",
      "files": {"win64": ["include/ai.h", "include/ai_version.h", "lib/ai.lib", "bin/ai.dll", "EULA.txt"],
                "macos-arm64": ["include/ai.h", "include/ai_version.h", "bin/libai.dylib", "EULA.txt"]}
    }
  },
  "cmake": ["-Wno-dev", "-DARNOLD_LOCATION={arnold}", "-DUSD_LOCATION={usd}",
            "-DBUILD_RENDER_DELEGATE=ON", "-DBUILD_NDR_PLUGIN=ON", "-DBUILD_USD_IMAGING_PLUGIN=ON",
            "-DBUILD_SCENE_INDEX_PLUGIN=ON", "-DBUILD_PROCEDURAL=OFF", "-DBUILD_SCHEMAS=OFF",
            "-DBUILD_TESTSUITE=OFF", "-DBUILD_DOCS=OFF", "-DPREFIX_PLUGINS=."],
  "install_prefix": "plugin/arnold",
  "licenses": {
    "arnold-sdk": ["{arnold}/EULA.txt"]
  },
  "platforms": ["win64", "macos-arm64"],
  "license": "Apache-2.0",
  "set": "local",
  "publish": false,
  "check": {
    "preload": {"win64": ["{arnold}/bin/ai.dll"], "macos-arm64": ["{arnold}/bin/libai.dylib"]},
    "plugin_folders": ["plugin/arnold"],
    "plugins": ["hdArnold", "nodeRegistryArnold", "sceneIndexArnold", "usdImagingArnold"],
    "renderers": ["HdArnoldRendererPlugin"]
  }
}
