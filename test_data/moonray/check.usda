#usda 1.0
(
    doc = "The moonray pack's check renders this with each of its delegates (deps/usd-plugins/moonray.json)."
    defaultPrim = "World"
    upAxis = "Y"
)

def Xform "World"
{
    def Camera "camera"
    {
        float focalLength = 35
        float horizontalAperture = 36
        float verticalAperture = 24
        float2 clippingRange = (0.1, 100)
        double3 xformOp:translate = (0, 1, 7)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def DomeLight "dome"
    {
        float inputs:intensity = 0.6
    }

    def DistantLight "sun"
    {
        float inputs:intensity = 2
        float3 xformOp:rotateXYZ = (-45, 30, 0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }

    def Sphere "sphere" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/red>
        double3 xformOp:translate = (-1.2, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cube "cube"
    {
        double size = 1.5
        color3f[] primvars:displayColor = [(0.2, 0.7, 0.3)]
        double3 xformOp:translate = (1.2, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Material "red"
    {
        token outputs:surface.connect = </World/red/surface.outputs:surface>

        def Shader "surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.8, 0.1, 0.1)
            float inputs:roughness = 0.4
            token outputs:surface
        }
    }
}
