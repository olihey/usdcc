#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
    metersPerUnit = 1
)
def Xform "World" {
    def Cube "Cube" {
        double size = 2
        color3f[] primvars:displayColor = [(0.8, 0.15, 0.05)]
    }
    def Sphere "Sphere" {
        double radius = 1
        double3 xformOp:translate = (3, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(0.1, 0.4, 0.9)]
    }
    def DistantLight "Key" {
        float inputs:intensity = 3000
        float3 xformOp:rotateXYZ = (-35, -30, 0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }
}

# Also usable directly by the isolated native SDK probe.
def Scope "Render" {
    def Camera "Camera" {
        float focalLength = 10
        float horizontalAperture = 14.72759
        float verticalAperture = 8.28427
        double3 xformOp:translate = (7, 4, 10)
        float3 xformOp:rotateXYZ = (-20, 35, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
    def RenderProduct "Product" {
        uniform int2 resolution = (960, 540)
        rel camera = </Render/Camera>
        token omni:rtx:rendermode = "RealTimePathTracing"
        rel orderedVars = </Render/Product/LdrColor>
        def RenderVar "LdrColor" {
            uniform string sourceName = "LdrColor"
        }
    }
}
