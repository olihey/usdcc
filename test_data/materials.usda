#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "World"
{
    def Sphere "WoodBall" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/Looks/Wood>
    }

    def Cube "SteelBox" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/Looks/Steel>
    }

    def Scope "Looks"
    {
        # USD's preview nodes, with a NodeGraph inside and an interface on both.
        def Material "Wood"
        {
            float inputs:tiling = 2
            token outputs:surface.connect = </World/Looks/Wood/Surface.outputs:surface>
            token outputs:displacement.connect = </World/Looks/Wood/Surface.outputs:displacement>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </World/Looks/Wood/Maps.outputs:color>
                float inputs:roughness = 0.6
                normal3f inputs:normal.connect = </World/Looks/Wood/Normal.outputs:rgb>
                token outputs:surface
                token outputs:displacement
            }

            def NodeGraph "Maps"
            {
                float inputs:tiling.connect = </World/Looks/Wood.inputs:tiling>
                color3f outputs:color.connect = </World/Looks/Wood/Maps/Tex.outputs:rgb>

                def Shader "UV"
                {
                    uniform token info:id = "UsdPrimvarReader_float2"
                    string inputs:varname = "st"
                    float2 outputs:result
                }

                def Shader "Tex"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @wood.png@
                    float2 inputs:st.connect = </World/Looks/Wood/Maps/UV.outputs:result>
                    float3 outputs:rgb
                }
            }

            def Shader "Normal"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @wood_normal.png@
                float3 outputs:rgb
            }
        }

        # MaterialX, whose standard_surface has pages of inputs.
        def Material "Steel"
        {
            token outputs:mtlx:surface.connect = </World/Looks/Steel/Surface.outputs:out>

            def Shader "Surface"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                color3f inputs:base_color.connect = </World/Looks/Steel/Multiply.outputs:out>
                float inputs:metalness = 1
                float inputs:specular_roughness = 0.25
                token outputs:out
            }

            def Shader "Multiply"
            {
                uniform token info:id = "ND_multiply_color3"
                color3f inputs:in1.connect = </World/Looks/Steel/Tint.outputs:out>
                color3f inputs:in2 = (0.8, 0.8, 0.85)
                color3f outputs:out
            }

            def Shader "Tint"
            {
                uniform token info:id = "ND_constant_color3"
                color3f inputs:value = (0.9, 0.9, 0.9)
                color3f outputs:out
            }
        }
    }
}
