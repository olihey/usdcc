#usda 1.0
(
    doc = """Rigid bodies falling onto a ground plane (docs/PHYSICS.md). Turn on Simulate in
    the timeline and play: a box, a sphere and a convex-hull mesh drop, bounce and settle;
    the tilted ramp is a static collider."""
    defaultPrim = "World"
    endTimeCode = 120
    metersPerUnit = 1
    startTimeCode = 1
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "World"
{
    def PhysicsScene "PhysicsScene"
    {
    }

    def Material "Rubber" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0.6
        float physics:restitution = 0.5
        float physics:staticFriction = 0.8
    }

    def Plane "Ground" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        uniform token axis = "Y"
        double length = 20
        double width = 20
    }

    def Cube "Ramp" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double size = 1
        float3 xformOp:rotateXYZ = (0, 0, -20)
        float3 xformOp:scale = (4, 0.2, 2)
        double3 xformOp:translate = (-1, 1, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }

    def Cube "Box" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI"]
    )
    {
        double size = 0.8
        double3 xformOp:translate = (-1.5, 4, 0)
        float3 xformOp:rotateXYZ = (15, 30, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    def Sphere "Ball" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </World/Rubber>
        double radius = 0.4
        double3 xformOp:translate = (1.5, 6, 0.2)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Mesh "Wedge" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
    )
    {
        int[] faceVertexCounts = [3, 3, 4, 4, 4]
        int[] faceVertexIndices = [0, 2, 1, 3, 4, 5, 0, 1, 4, 3, 1, 2, 5, 4, 2, 0, 3, 5]
        uniform token physics:approximation = "convexHull"
        point3f[] points = [(-0.5, 0, -0.5), (0.5, 0, -0.5), (-0.5, 0.8, -0.5), (-0.5, 0, 0.5), (0.5, 0, 0.5), (-0.5, 0.8, 0.5)]
        double3 xformOp:translate = (0.2, 8, -0.3)
        float3 xformOp:rotateXYZ = (0, 0, 40)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
}
