// Windows resource script: gives usdcc.exe its icon (Explorer, taskbar pins,
// Alt-Tab) and its version (Explorer's Properties > Details). The window icon
// shown while the app runs is set from Qt resources instead — see
// usdcc::ui::theme::appIcon(). The .ico is generated by tools/gen_app_icon.py.
// The version comes from usdcc_version.h, which CMake writes from the release's
// tag (docs/RELEASE.md §2).
#include <winver.h>
#include "usdcc_version.h"

1 ICON "usdcc.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION USDCC_RC_VERSION
PRODUCTVERSION USDCC_RC_VERSION
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS USDCC_RC_FLAGS
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "usdcc"
            VALUE "FileDescription", "usdcc, a USD editor"
            VALUE "FileVersion", USDCC_RC_VERSION_STRING
            VALUE "InternalName", "usdcc"
            VALUE "LegalCopyright", "Copyright (c) 2026, Oliver Heyme. BSD-3-Clause."
            VALUE "OriginalFilename", "usdcc.exe"
            VALUE "ProductName", "usdcc"
            VALUE "ProductVersion", USDCC_RC_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
