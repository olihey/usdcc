<?xml version="1.0"?>
<!--
  Shiboken6 typesystem for the usdcc.ui Python module.

  usdcc::ui::SidePanel derives from Qt (QDockWidget), already known via
  PySide6's own QtWidgets typesystem, loaded below.

  ViewPanel is NOT bound here (see bindings.h's comment): its constructor now
  requires usdcc::usd::StageManager*/StageRefPtr, pybind11 types this
  Shiboken6 pipeline has no way to know about or convert.
-->
<typesystem package="usdcc.ui">
    <load-typesystem name="typesystem_widgets.xml" generate="no"/>

    <!-- Both classes get a moc-generated qt_metacall() override (Q_OBJECT).
         Shiboken's virtual-override codegen for it hits a known void**
         conversion bug (see PySide6's own typesystem_axcontainer.xml, which
         works around the same thing for its own classes); qt_metacall isn't
         meant to be Python-overridden anyway, so drop it like PySide does. -->
    <rejection class="*" function-name="qt_metacall"/>

    <!-- This namespace only exists so shiboken can resolve
         usdcc::ui::SidePanel's qualified C++ name (a bare, unqualified
         <object-type name="SidePanel"/> fails to match — shiboken needs the
         enclosing namespaces spelled out). That makes the class land at
         usdcc.ui.usdcc.ui.SidePanel; visible="no" to flatten that hits a
         shiboken codegen bug (undeclared SBK_...IDX in the namespace
         wrapper), so instead __init__.py re-exports SidePanel at the top
         level after import — see that file. -->
    <namespace-type name="usdcc">
        <namespace-type name="ui">
            <!-- Every QObject-derived binding gets generated code reaching
                 into Qt's dynamic-property system (PySide::Property::
                 getObject/setValue), but pysideproperty.h isn't pulled in by
                 the QtWidgets/QtGui/QtCore aggregator headers shiboken
                 includes automatically — PySide6's own bindings get it for
                 free because they bind QObject itself. Without this each
                 wrapper fails to compile with "'PySide': is not a class or
                 namespace name". -->
            <object-type name="SidePanel">
                <extra-includes>
                    <include file-name="pysideproperty.h" location="global"/>
                </extra-includes>
            </object-type>
        </namespace-type>
    </namespace-type>
</typesystem>
