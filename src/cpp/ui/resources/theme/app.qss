/*
 * usdcc's app-wide Qt stylesheet, for every theme (docs/THEMES.md).
 *
 * Derived from the "3D DCC with Modern Dark Design" Claude Design project
 * (option 1a, "Classic — Blender-style dense workspace").
 *
 * No colours here: "@surface-panel" and the like are tokens, replaced by the
 * theme's colours (theme.cpp's table has them all, with the two built-in
 * themes' values) before this is applied, and again whenever the theme or the
 * accent changes. "@token-rgb" is the colour's "r, g, b", for
 * rgba(@ink-rgb, 50%). What a token is for:
 *
 *   surfaces   @surface-bar menu/status/header   @surface-toolbar bars
 *              @surface-panel panels   @surface-raised buttons, tips
 *              @surface-hover a hovered button   @inset inputs, tracks   @gap gaps
 *   hairlines  @overlay-rgb at 6% dividers   8% input borders   10% popups
 *   text       @text primary   @ink-rgb at 75% / 50% / 40% secondary, muted, labels
 *              @text-strong on a tinted selection   @on-accent on the solid accent
 *   accent     @accent fills   @accent-hover   @accent-text as text
 *   radii      3px controls, 4px groups     density: 11px type, 20px controls
 *
 * Dock-system (ADS) widgets need their own overrides — see dock.qss for why.
 *
 * Qt stylesheets have no letter-spacing or text-transform, so the design's
 * letter-spaced uppercase section labels aren't reproduced.
 */

QWidget {
    font-family: "Inter", "Segoe UI", "Helvetica Neue", sans-serif;
    font-size: 11px;
}

QMainWindow,
QDialog {
    background: @surface-panel;
}

QToolTip {
    background: @surface-raised;
    color: @text;
    border: 1px solid rgba(@overlay-rgb, 10%);
    padding: 3px 6px;
}

QLabel {
    color: rgba(@ink-rgb, 55%);
}

/* ---- Menus ---------------------------------------------------------- */

QMenuBar {
    background: @surface-bar;
    color: rgba(@ink-rgb, 65%);
    border-bottom: 1px solid rgba(@overlay-rgb, 6%);
    min-height: 26px;
    padding: 0 6px;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 8px;
    margin: 2px 0;
    border-radius: 3px;
}

QMenuBar::item:selected {
    background: rgba(@overlay-rgb, 10%);
    color: @text;
}

QMenu {
    background: @surface-panel;
    color: rgba(@ink-rgb, 75%);
    border: 1px solid rgba(@overlay-rgb, 10%);
    padding: 4px;
}

QMenu::item {
    padding: 4px 24px 4px 22px;
    border-radius: 3px;
}

QMenu::item:selected {
    background: @accent;
    color: @on-accent;
}

QMenu::item:disabled {
    color: rgba(@ink-rgb, 30%);
}

QMenu::separator {
    height: 1px;
    background: rgba(@overlay-rgb, 8%);
    margin: 4px 6px;
}

QMenu::indicator {
    width: 11px;
    height: 11px;
    left: 6px;
}

QMenu::indicator:non-exclusive:checked {
    image: url(:/usdcc/theme/check.png);
    background: @accent;
    border-radius: 2px;
}

/* ---- Inputs --------------------------------------------------------- */

QComboBox,
QLineEdit,
QAbstractSpinBox {
    min-height: 18px;
    padding: 0 8px;
    background: @inset;
    color: rgba(@ink-rgb, 75%);
    border: 1px solid rgba(@overlay-rgb, 8%);
    border-radius: 3px;
    selection-background-color: @accent;
    selection-color: @on-accent;
}

QComboBox:hover,
QLineEdit:hover,
QAbstractSpinBox:hover {
    border-color: rgba(@overlay-rgb, 18%);
}

QComboBox:focus,
QComboBox:on,
QLineEdit:focus,
QAbstractSpinBox:focus {
    border-color: @accent;
}

/* A field that can't be edited (the Attribute Editor's Type, Specifier,
   relationship targets, ...): flatter than an editable one and nearer the
   panel, with a faint border that doesn't light up. Number fields paint the
   same (properties::style::readOnlyFill()). */
QLineEdit:read-only,
QLineEdit:read-only:hover,
QLineEdit:read-only:focus {
    background: @surface-readonly;
    border-color: rgba(@overlay-rgb, 5%);
}

/* Otherwise the native style's bevels, which are hard lines in a light theme. */
QAbstractSpinBox::up-button,
QAbstractSpinBox::down-button {
    subcontrol-origin: border;
    width: 16px;
    border: none;
    background: transparent;
}

QAbstractSpinBox::up-button {
    subcontrol-position: top right;
}

QAbstractSpinBox::down-button {
    subcontrol-position: bottom right;
}

QAbstractSpinBox::up-button:hover,
QAbstractSpinBox::down-button:hover {
    background: rgba(@overlay-rgb, 10%);
}

QAbstractSpinBox::up-arrow {
    image: url(:/usdcc/theme/chevron-up.png);
    width: 10px;
    height: 10px;
}

QAbstractSpinBox::down-arrow {
    image: url(:/usdcc/theme/chevron-down.png);
    width: 10px;
    height: 10px;
}

/* e.g. a panel's Stage dropdown while no stage is open */
QComboBox:disabled {
    color: rgba(@ink-rgb, 30%);
    background: transparent;
}

QComboBox::drop-down {
    border: none;
    width: 16px;
}

QComboBox::down-arrow {
    image: url(:/usdcc/theme/chevron-down.png);
    width: 16px;
    height: 16px;
}

QComboBox QAbstractItemView {
    background: @surface-panel;
    color: rgba(@ink-rgb, 75%);
    border: 1px solid rgba(@overlay-rgb, 10%);
    selection-background-color: @accent;
    selection-color: @on-accent;
    outline: 0;
}

QPushButton,
QToolButton {
    min-height: 18px;
    padding: 0 10px;
    background: @surface-raised;
    color: @text;
    border: 1px solid rgba(@overlay-rgb, 8%);
    border-radius: 3px;
}

/* A line edit's clear button is a QToolButton too, but Qt sizes and places it
   itself (theme.cpp's Style keeps it as far from the right edge as from the
   top and bottom): a min-height here would stretch it and push the icon down. */
QLineEdit > QToolButton {
    min-height: 0;
    min-width: 0;
    padding: 0;
    border: none;
    background: transparent;
}

QPushButton:hover,
QToolButton:hover {
    background: @surface-hover;
}

QPushButton:pressed,
QToolButton:pressed,
QPushButton:default,
QToolButton:checked {
    background: @accent;
    border-color: @accent;
    color: @on-accent;
}

/* One look for every button that can't be pressed, a dialog's main one (Add Input, Connect,
   ...) and a checked one included: the plain button, dimmed, never the accent. After
   :default and :checked, which it overrides. */
QPushButton:disabled,
QToolButton:disabled {
    background: @surface-raised;
    border-color: rgba(@overlay-rgb, 8%);
    color: rgba(@ink-rgb, 30%);
}

QCheckBox,
QRadioButton {
    color: rgba(@ink-rgb, 75%);
    spacing: 6px;
}

QCheckBox::indicator,
QTreeView::indicator,
QTableView::indicator,
QListView::indicator {
    width: 11px;
    height: 11px;
    background: @inset;
    border: 1px solid rgba(@overlay-rgb, 18%);
    border-radius: 2px;
}

QCheckBox::indicator:checked,
QTreeView::indicator:checked,
QTableView::indicator:checked,
QListView::indicator:checked {
    background: @accent;
    border-color: @accent;
    image: url(:/usdcc/theme/check.png);
}

/* Partly checked: a tree node with only some children checked. */
QCheckBox::indicator:indeterminate,
QTreeView::indicator:indeterminate,
QTableView::indicator:indeterminate,
QListView::indicator:indeterminate {
    background: @accent;
    border-color: @accent;
    image: url(:/usdcc/theme/check-partial.png);
}

QSlider::groove:horizontal {
    height: 4px;
    background: @inset;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: @accent;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    width: 10px;
    margin: -3px 0;
    border-radius: 5px;
    background: @text;
}

QProgressBar {
    height: 4px;
    background: @inset;
    border: none;
    border-radius: 2px;
    text-align: center;
    color: transparent;
}

QProgressBar::chunk {
    background: @accent;
    border-radius: 2px;
}

/* ---- Item views ----------------------------------------------------- */

QTreeView,
QTableView,
QListView {
    background: @surface-panel;
    alternate-background-color: @surface-panel;
    color: rgba(@ink-rgb, 75%);
    border: none;
    outline: 0;
    gridline-color: rgba(@overlay-rgb, 6%);
    selection-background-color: rgba(@accent-rgb, 18%);
    selection-color: @text-strong;
}

QTreeView::item,
QListView::item {
    padding: 3px 6px;
    border-radius: 3px;
}

QTableView::item {
    padding: 3px 6px;
}

QTreeView::item:hover,
QListView::item:hover {
    background: rgba(@overlay-rgb, 5%);
}

QTreeView::item:selected,
QListView::item:selected,
QTableView::item:selected {
    background: rgba(@accent-rgb, 18%);
    color: @text-strong;
}

/* Otherwise Fusion also fills a selected row's indent (the branch area) with
   the selection colour; the rest of the indent is theme.cpp's Style. */
QTreeView {
    show-decoration-selected: 0;
}

QHeaderView::section {
    background: @surface-bar;
    color: rgba(@ink-rgb, 40%);
    border: none;
    border-bottom: 1px solid rgba(@overlay-rgb, 6%);
    border-right: 1px solid rgba(@overlay-rgb, 6%);
    padding: 4px 8px;
}

QTableCornerButton::section {
    background: @surface-bar;
    border: none;
}

QTextEdit,
QPlainTextEdit {
    background: @inset;
    color: rgba(@ink-rgb, 75%);
    border: none;
    selection-background-color: rgba(@accent-rgb, 45%);
    selection-color: @text-strong;
}

/* The Script Editor panel's editor and output (docs/SCRIPTING.md section 7),
   and code views (usdcc::ui::TextView, e.g. the USDA view): monospace, at the
   app's (scaled) font size. */
QPlainTextEdit#scriptEditor,
QPlainTextEdit#scriptOutput,
QAbstractScrollArea#codeView {
    font-family: "Cascadia Mono", "Consolas", "DejaVu Sans Mono", monospace;
}

QAbstractScrollArea#codeView,
QGraphicsView {
    border: 1px solid rgba(@overlay-rgb, 6%);
}

QAbstractScrollArea::corner {
    background: transparent;
    border: none;
}

QPlainTextEdit#scriptEditor,
QPlainTextEdit#codeView {
    background: @surface-panel;
}

/* Its tabs, in its toolbar row, styled like a ViewPanel's tab strip
   (dock.qss): the current tab filled with the accent blue, solid while focus
   is in the panel (focused="true", set from code) and muted otherwise. */
QTabBar#scriptTabs {
    background: transparent;
}

QTabBar#scriptTabs::tab {
    background: transparent;
    color: rgba(@ink-rgb, 50%);
    padding: 4px 4px 4px 8px;
    border-style: solid;
    border-width: 0 1px 2px 0;
    border-color: transparent rgba(@overlay-rgb, 6%) transparent transparent;
}

QTabBar#scriptTabs::tab:hover {
    background: rgba(@overlay-rgb, 5%);
    color: rgba(@ink-rgb, 75%);
}

QTabBar#scriptTabs::tab:selected {
    background: rgba(@accent-rgb, 25%);
    color: @text;
}

QTabBar#scriptTabs::tab:selected:hover {
    background: rgba(@accent-rgb, 35%);
}

QTabBar#scriptTabs[focused="true"]::tab:selected {
    background: @accent;
    color: @on-accent;
    border-color: transparent @accent @accent transparent;
}

QTabBar#scriptTabs[focused="true"]::tab:selected:hover {
    background: @accent-hover;
}

/* The Peers panel's emoji and Send buttons beside the message, square, and the emoji
   grid (docs/PEERS.md §14.3): square cells with nothing but the emoji, which a button's
   usual padding would leave no room for. */
QToolButton#peersEmoji,
QToolButton#peersSend {
    padding: 0;
}

QToolButton#peersEmoji::menu-indicator {
    image: none;
    width: 0;
}

/* The Peers panel: You (with your status, a menu), the chat's tabs (the room's and each
   private conversation's) and who is typing under it. */
QToolButton#peersYou {
    background: transparent;
    border: none;
    padding: 2px 4px;
}

QToolButton#peersYou:hover {
    background: rgba(@overlay-rgb, 8%);
}

QToolButton#peersYou::menu-indicator {
    image: none;
    width: 0;
}

QTabBar#peersChatTabs::tab {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 3px 10px;
    color: @muted-strong;
}

QTabBar#peersChatTabs::tab:selected {
    color: @text;
    border-bottom-color: @accent;
}

QTabBar#peersChatTabs::tab:hover:!selected {
    color: @text;
}

QTabBar#peersChatTabs::close-button {
    image: url(:/usdcc/theme/close.png);
    subcontrol-position: right;
    width: 14px;
    height: 14px;
    border-radius: 3px;
}

QTabBar#peersChatTabs::close-button:hover {
    image: url(:/usdcc/theme/close-white.png);
    background: rgba(@overlay-rgb, 10%);
}

QLabel#peersTyping {
    color: @muted;
    font-style: italic;
    padding: 1px 4px;
}

QToolButton#peersEmojiCell {
    min-height: 0;
    padding: 0;
    font-size: 18px;
    background: transparent;
    border: none;
    border-radius: 4px;
}

QToolButton#peersEmojiCell:hover {
    background: rgba(@overlay-rgb, 10%);
}

QToolButton#peersEmojiCell:pressed {
    background: @accent;
}

QToolButton#scriptTabClose {
    background: transparent;
    border: none;
    border-radius: 3px;
    padding: 0;
    qproperty-icon: url(:/usdcc/theme/close.png);
}

QToolButton#scriptTabClose:hover {
    background: rgba(@overlay-rgb, 10%);
}

QToolButton#scriptTabClose:pressed {
    background: rgba(@overlay-rgb, 16%);
}

/* White on the focused tab's solid blue, where the grey icon washes out. */
QToolButton#scriptTabClose[onAccent="true"] {
    qproperty-icon: url(:/usdcc/theme/close-white.png);
}

/* ---- Scroll bars ---------------------------------------------------- */

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: rgba(@overlay-rgb, 15%);
    border-radius: 3px;
    min-height: 24px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: rgba(@overlay-rgb, 15%);
    border-radius: 3px;
    min-width: 24px;
    margin: 2px;
}

/* Nothing to scroll, where a panel always keeps the bar's room. */
QScrollBar::handle:vertical:disabled {
    background: transparent;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background: rgba(@overlay-rgb, 28%);
}

QScrollBar::add-line,
QScrollBar::sub-line {
    width: 0;
    height: 0;
    border: none;
    background: none;
}

QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
}

/* ---- Window furniture ----------------------------------------------- */

QStatusBar {
    background: @surface-bar;
    color: rgba(@ink-rgb, 50%);
    border-top: 1px solid rgba(@overlay-rgb, 6%);
    min-height: 24px;
}

/* Its items are flat words, as an editor's status bar has them: no frames between them, no
   button look and no arrow; a hovered one gets a soft, rounded ground. */
QStatusBar::item {
    border: none;
}

QStatusBar QLabel,
QStatusBar QToolButton {
    background: transparent;
    border: none;
    border-radius: 3px;
    color: rgba(@ink-rgb, 65%);
    padding: 0 7px;
    margin: 0 1px;
    min-height: 20px;
}

QStatusBar QToolButton:hover {
    background: @surface-hover;
    color: @text;
}

QStatusBar QToolButton:pressed,
QStatusBar QToolButton:open {
    background: rgba(@overlay-rgb, 12%);
    color: @text;
}

QStatusBar QToolButton::menu-indicator {
    image: none;
    width: 0;
}

/* One that isn't as usual, such as a stage in another asset environment than the default. */
QStatusBar QToolButton[attention="true"] {
    color: @accent-text;
}

QMainWindow::separator,
QSplitter::handle {
    background: @inset;
    width: 1px;
    height: 1px;
}

/* A plain QDockWidget, as a script may add one. */
QDockWidget {
    color: rgba(@ink-rgb, 50%);
}

QDockWidget::title {
    background: @surface-bar;
    padding: 5px 8px;
    text-align: left;
    border-bottom: 1px solid rgba(@overlay-rgb, 6%);
}

/* ---- Custom title bar (title_bar.cpp) -------------------------------- */

QFrame#titleBar {
    background: @surface-bar;
    border-bottom: 1px solid rgba(@overlay-rgb, 6%);
}

/* The bar supplies the background and divider; the menu bar inside it must
   not draw its own. */
QFrame#titleBar QMenuBar {
    background: transparent;
    border: none;
    padding: 0;
    min-height: 0;
}

/* The items must fit inside the bar's fixed height, or the menu bar treats
   them as overflowing and hides them behind its ">>" button. */
QFrame#titleBar QMenuBar::item {
    padding: 3px 8px;
    margin: 0;
}

/* The app icon (set from code), with the design's 10px side gutters. */
QLabel#titleBarLogo {
    background: transparent;
    margin: 0 10px;
}

QLabel#titleBarTitle {
    color: rgba(@ink-rgb, 50%);
}

QLabel#titleBarTitle[active="false"] {
    color: rgba(@ink-rgb, 28%);
}

QToolButton#titleBarButton,
QToolButton#titleBarCloseButton {
    background: transparent;
    border: none;
    border-radius: 0;
    padding: 0;
    min-width: 46px;
    max-width: 46px;
}

QToolButton#titleBarButton:hover {
    background: rgba(@overlay-rgb, 10%);
}

QToolButton#titleBarButton:pressed {
    background: rgba(@overlay-rgb, 16%);
}

QToolButton#titleBarCloseButton:hover {
    background: #e81123;
}

QToolButton#titleBarCloseButton:pressed {
    background: #f1707a;
}

/* The workspace button (docs/WORKSPACES.md §6.1), left of the caption buttons: a
   push button on the accent fill, the workspace's name and a down arrow on its
   right; as tall as a control, not the title bar. Its height is set here, not in
   code: QToolButton's min-height above would replace a height set in code when the
   button is first shown, making it a pixel short until the first UI scale change. */
QToolButton#titleBarWorkspaceButton {
    background: @accent;
    border: none;
    border-radius: 3px;
    color: @on-accent;
    font-weight: 600;
    padding: 0 22px 0 10px;
    margin-right: 8px;
    min-height: 22px;
    max-height: 22px;
}

QToolButton#titleBarWorkspaceButton:hover {
    background: @accent-hover;
}

QToolButton#titleBarWorkspaceButton:pressed,
QToolButton#titleBarWorkspaceButton:open {
    background: rgba(@accent-rgb, 75%);
}

QToolButton#titleBarWorkspaceButton::menu-indicator {
    image: url(:/usdcc/theme/chevron-down-white.png);
    subcontrol-origin: padding;
    subcontrol-position: center right;
    right: 4px;
    width: 14px;
    height: 14px;
}

/* The workspace menu's group headings: labels, not choices. */
QLabel#workspaceMenuHeading {
    color: rgba(@ink-rgb, 40%);
    font-size: 8pt;
    font-weight: 600;
    padding: 6px 12px 2px 12px;
}

/* ---- Main-window tool rail and tool-options bar (the design's left rail
        and "tool options bar"). Both are QToolBars in the QMainWindow layout. */

/* Both bars can be dragged to other edges or floated. viewport_tool_bars.cpp
   keeps an "area" property (left/right/top/bottom/floating) up to date so the
   divider line can sit on the edge facing the content. */
QToolBar {
    background: @surface-toolbar;
    border: none;
    padding: 0;
    spacing: 0;
}

QToolBar[area="left"] {
    border-right: 1px solid rgba(@overlay-rgb, 6%);
}

QToolBar[area="right"] {
    border-left: 1px solid rgba(@overlay-rgb, 6%);
}

QToolBar[area="top"] {
    border-bottom: 1px solid rgba(@overlay-rgb, 6%);
}

QToolBar[area="bottom"] {
    border-top: 1px solid rgba(@overlay-rgb, 6%);
}

QToolBar[area="floating"] {
    border: 1px solid rgba(@overlay-rgb, 12%);
}

/* The drag handle: a grip of dots, oriented to the bar. */
QToolBar::handle:horizontal {
    image: url(:/usdcc/theme/grip-horizontal.png);
    width: 16px;
}

QToolBar::handle:vertical {
    image: url(:/usdcc/theme/grip-vertical.png);
    height: 16px;
}

/* The rail has no spacing or padding of its own (QToolBar's 0 above): its 24 px
   buttons sit edge to edge in a 24 px strip. */
QToolBar#toolRail QToolButton {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 0;
    margin: 0;
    min-width: 24px;
    max-width: 24px;
    min-height: 24px;
    max-height: 24px;
}

QToolBar#toolRail QToolButton:hover {
    background: rgba(@overlay-rgb, 10%);
}

QToolBar#toolRail QToolButton:checked {
    background: @accent;
}

/* The contents; the toolbar above supplies the background and divider. */
QFrame#toolOptionsBar {
    background: transparent;
    border: none;
}

QLabel#toolOptionsTitle {
    color: @text;
    font-weight: 600;
}

QFrame#toolOptionsSeparator {
    background: rgba(@overlay-rgb, 10%);
    border: none;
    min-width: 1px;
    max-width: 1px;
    min-height: 14px;
    max-height: 14px;
}

QLabel:disabled {
    color: rgba(@ink-rgb, 25%);
}

/* A row of mutually exclusive choices (the design's "Box / Lasso / Paint"
   pill group). */
QFrame#segmented {
    background: @inset;
    border-radius: 4px;
}

QToolButton#segmentButton {
    background: transparent;
    border: none;
    border-radius: 3px;
    padding: 3px 8px;
    min-height: 0;
    color: rgba(@ink-rgb, 55%);
}

QToolButton#segmentButton:hover {
    color: @text;
}

QToolButton#segmentButton:checked {
    background: @accent;
    color: @on-accent;
}

/* The Stage/Renderer row at the top of each ViewPanel (the design's
   "tool options bar"). */
QWidget#panelToolbar {
    background: @surface-toolbar;
    border-bottom: 1px solid rgba(@overlay-rgb, 6%);
}

/* The timeline, under the dock area (docs/ANIMATION.md §4.3): a bar like the
   panels' toolbars, with its line on top. */
QWidget#timelineBar {
    background: @surface-toolbar;
    border-top: 1px solid rgba(@overlay-rgb, 6%);
}

/* Icon-only squares in panel toolbars: the options/filter menu button and
   PanelIconButtons such as the Log panel's Clear and Log Folder. */
QToolButton#panelMenuButton,
QToolButton#panelIconButton,
QToolButton[panelIcon="true"] {
    padding: 0;
}

/* ---- Attribute editor / property widgets ------------------------------
   (docs/ATTRIBUTE_EDITOR.md §4.2). The number fields and color chips are
   custom-painted with the same tokens (see properties/property_style.h). */

QLabel#propertyLabel {
    color: rgba(@ink-rgb, 55%);
}

/* Showing a schema fallback, nothing authored. */
QLabel#propertyLabel[unauthored="true"] {
    color: rgba(@ink-rgb, 35%);
    font-style: italic;
}

QLabel#propertyNote {
    color: rgba(@ink-rgb, 35%);
}

/* A primvar's note when something's wrong with it (docs/PRIMVAR_VIEWER.md section 8). */
QLabel#propertyNote[severity="error"] {
    color: @error;
}

QLabel#propertyNote[severity="warning"] {
    color: @warning;
}

QLabel#propertyBadge {
    color: @accent-text;
    font-size: 10px;
}

/* A row's key (docs/ANIMATION.md phase 2): muted when the attribute isn't animated, the
   accent when it is, filled (its glyph) when there's a key at the frame shown. */
QToolButton#propertyKeyButton {
    color: @muted;
    border: none;
    background: transparent;
    padding: 0;
}
QToolButton#propertyKeyButton[keyState="animated"],
QToolButton#propertyKeyButton[keyState="keyed"] {
    color: @accent-text;
}
QToolButton#propertyKeyButton:disabled {
    color: rgba(@text-rgb, 25%);
}

/* Second line under a value: resolved asset path, connection source. */
QLabel#propertySubLine {
    color: @accent-text;
    font-size: 10px;
}

QLabel#propertySubLine[unresolved="true"] {
    color: @error;
}

/* Something to look at, not broken: e.g. a sublayer's up axis not the stage's. */
QLabel#propertySubLine[caution="true"] {
    color: @warning;
}

/* A connected input's source, under its value: selects the source prim. */
QToolButton#subLineLink {
    background: transparent;
    border: none;
    padding: 0;
    min-height: 0;
    color: @accent-text;
    font-size: 10px;
}

QToolButton#subLineLink:hover {
    color: @accent-hover;
    text-decoration: underline;
}

QLabel#propertyMatrixSummary,
QLabel#propertyArraySummary,
QLabel#propertyReadOnlyText {
    min-height: 18px;
    padding: 0 8px;
    background: @inset;
    color: rgba(@ink-rgb, 75%);
    border: 1px solid rgba(@overlay-rgb, 8%);
    border-radius: 3px;
}

/* The read-only look, as QLineEdit:read-only: a value with no editor (yet),
   an array's summary, edited only through its Edit button, and a matrix's
   (a transform op's), edited in the grid it opens. */
QLabel#propertyReadOnlyText,
QLabel#propertyArraySummary,
QLabel#propertyMatrixSummary {
    background: @surface-readonly;
    border-color: rgba(@overlay-rgb, 5%);
}

QPushButton#propertyButton,
QToolButton#propertyButton {
    padding: 0 8px;
}

/* Square buttons in property rows and section headers (Edit, Remove, Add,
   an asset's Rel and ...; properties::iconButton()): all one size, the
   height of a field (style::kFieldHeight). Set here, since a stylesheet's
   min-width overrides a fixed size and the layout would shrink an icon-only
   one to its icon. 18px inside the 1px border makes 20. */
QToolButton#propertyIconButton {
    padding: 0;
    min-width: 18px;
    max-width: 18px;
    min-height: 18px;
    max-height: 18px;
}

QToolButton#propertyIconButton::menu-indicator {
    image: none;
    width: 0;
}

QTabWidget::pane {
    border: 1px solid rgba(@overlay-rgb, 6%);
    border-radius: 4px;
    top: -1px;
}

QTabBar::tab {
    background: transparent;
    color: rgba(@ink-rgb, 55%);
    padding: 5px 10px;
    border: none;
    border-bottom: 2px solid transparent;
}

QTabBar::tab:hover {
    color: @text;
}

QTabBar::tab:selected {
    color: @text;
    border-bottom-color: @accent;
}

/* Expand/collapse arrow (a matrix's full grid). */
QToolButton#propertyDisclosure,
QToolButton#propertyDisclosure:checked,
QToolButton#propertyDisclosure:pressed {
    background: transparent;
    border: none;
    padding: 0;
    min-width: 16px;
    max-width: 16px;
}

/* Attribute editor sections (CategorySection). */
QFrame#sectionSeparator {
    background: rgba(@overlay-rgb, 6%);
}

QToolButton#sectionHeader,
QToolButton#sectionHeader:hover,
QToolButton#sectionHeader:pressed {
    background: transparent;
    border: none;
    padding: 0 2px;
    min-height: 18px;
    color: @text;
    font-weight: 600;
}

/* An applied schema in the Attribute Editor's Prim section: built in (from the
   prim's type or another schema) is dimmed, not registered is amber. */
QFrame#schemaPill {
    background: rgba(@overlay-rgb, 8%);
    border: 1px solid rgba(@overlay-rgb, 8%);
    border-radius: 10px;
}

QFrame#schemaPill[state="builtIn"] {
    background: transparent;
}

QFrame#schemaPill[state="builtIn"] QLabel {
    color: rgba(@ink-rgb, 50%);
}

QFrame#schemaPill[state="unregistered"] {
    border-color: @warning;
}

QFrame#schemaPill[state="unregistered"] QLabel {
    color: @warning;
}

/* A relationship target's path, in a pill: it selects the prim. */
QToolButton#pillLink {
    background: transparent;
    border: none;
    padding: 0;
    min-height: 0;
}

QToolButton#pillLink:hover {
    color: @accent-text;
}

QFrame#schemaPill[state="unregistered"] QToolButton#pillLink {
    color: @warning;
}

QToolButton#schemaPillRemove {
    background: transparent;
    border: none;
    border-radius: 7px;
    padding: 0;
    min-width: 14px;
    max-width: 14px;
    min-height: 14px;
    max-height: 14px;
}

QToolButton#schemaPillRemove:hover {
    background: rgba(@overlay-rgb, 15%);
}

/* An editable reference or payload in the Attribute Editor's Composition
   section: just a border, on the panel's own background. */
QFrame#compositionArc {
    background: transparent;
    border: 1px solid rgba(@overlay-rgb, 8%);
    border-radius: 4px;
}

/* The namespace of the primvars in a frame. */
QLabel#propertyFrameTitle {
    color: rgba(@ink-rgb, 75%);
    font-weight: 600;
}

/* Edits are going into a variant (docs/VARIANT_EDITOR.md section 5): hard to miss. */
QFrame#variantEditBanner {
    background: rgba(@warning-rgb, 14%);
    border: 1px solid @warning;
    border-radius: 4px;
}

QFrame#variantEditBanner QLabel {
    color: @warning;
}

/* The USDA view's text is older than the stage (docs/USDA_VIEW.md section 4): the
   same amber, as a bar across the panel. */
QWidget#usdaStaleBar {
    background: rgba(@warning-rgb, 18%);
    border-top: 1px solid @warning;
    border-bottom: 1px solid @warning;
}

QWidget#usdaStaleBar QLabel {
    color: @warning;
    font-weight: 600;
}

/* Its Refresh: the accent, as a dialog's main button (QPushButton:default), without
   being the default, which would take Enter in the USDA preview dialog. */
QWidget#usdaStaleBar QPushButton {
    background: @accent;
    border-color: @accent;
    color: @on-accent;
}

QWidget#usdaStaleBar QPushButton:hover {
    background: @accent-hover;
    border-color: @accent-hover;
}

/* Transform stack (TransformStackEditor) and the tool target. */
QLabel#dragHandle {
    color: rgba(@ink-rgb, 35%);
    font-size: 13px;
}

QLabel#dragHandle:hover {
    color: @text;
}

QFrame#dropIndicator {
    background: @accent;
}

/* The op the Move/Rotate/Scale tools act on. */
QLabel#propertyLabel[target="true"] {
    color: @accent-text;
    font-weight: 600;
}

QCheckBox#sectionHeaderCheck {
    color: rgba(@ink-rgb, 55%);
}

QLabel#targetHint {
    color: @warning;
}

/* ---- Settings dialog (SettingsDialog, docs/SETTINGS.md) ---------------- */

QTreeWidget#settingsCategories {
    background: @surface-bar;
    border: 1px solid rgba(@overlay-rgb, 6%);
    border-radius: 4px;
    padding: 4px;
}

QTreeWidget#settingsCategories::item {
    padding: 4px 6px;
}

QScrollArea#settingsPage,
QWidget#settingsPageContent {
    background: @surface-panel;
}

/* A group is a CategorySection, as in the attribute editor; its title bar is
   lifted a little off the page, and the bar replaces the separator line. */
QWidget#settingsPageContent QWidget#sectionHeaderBar {
    background: rgba(@overlay-rgb, 5%);
    border-radius: 4px;
}

QWidget#settingsPageContent QFrame#sectionSeparator {
    background: transparent;
}

QLabel#settingLabel {
    color: rgba(@ink-rgb, 75%);
}

QLabel#settingConflict {
    color: @error;
}

QToolButton#settingReset {
    background: transparent;
    border: none;
    padding: 0 4px;
    color: rgba(@ink-rgb, 50%);
}

QToolButton#settingReset:hover {
    color: @accent-text;
}

/* A folder list sits on the page in the category tree's well, so it reads as
   a list and not as more of the page. */
QListWidget#settingFolderList {
    background: @surface-bar;
    alternate-background-color: @surface-bar;
    border: 1px solid rgba(@overlay-rgb, 6%);
    border-radius: 4px;
}

QToolButton#settingColorButton {
    padding: 0 8px 0 4px;
}

/* ---- Toast notifications (ToastWidget, docs/NOTIFICATIONS.md) ----------
   The card, its stripe, icon and countdown bar are painted (toast.cpp, in
   theme::toastColor()); these are its texts and buttons. */

QLabel#toastTitle {
    color: @text;
    font-weight: 600;
}

QLabel#toastBody {
    color: rgba(@ink-rgb, 75%);
}

QScrollArea#toastBodyScroll,
QScrollArea#toastBodyScroll > QWidget,
QScrollArea#toastBodyScroll > QWidget > QWidget {
    background: transparent;
    border: none;
}

QLabel#toastCount {
    color: rgba(@ink-rgb, 75%);
    background: rgba(@overlay-rgb, 10%);
    border-radius: 3px;
    padding: 0 4px;
    font-size: 10px;
}

QToolButton#toastClose {
    background: transparent;
    border: none;
    padding: 0;
    min-height: 0;
}

QToolButton#toastClose:hover {
    background: rgba(@overlay-rgb, 10%);
}

QPushButton#toastAction {
    min-height: 18px;
    padding: 0 10px;
}

QToolButton#toastDismissAll {
    background: @surface-raised;
    color: rgba(@ink-rgb, 75%);
    border: 1px solid rgba(@overlay-rgb, 10%);
    border-radius: 9px;
    padding: 0 10px;
    min-height: 18px;
}

QToolButton#toastDismissAll:hover {
    color: @text;
    background: @surface-hover;
}

/* Auto-key on (docs/ANIMATION.md phase 2): red, as the record button of a DCC is. */
QToolButton#timelineAutoKey:checked {
    background: #c0392b;
    color: #ffffff;
    border-radius: 3px;
}
