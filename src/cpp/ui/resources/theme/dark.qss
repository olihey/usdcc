/*
 * usdcc dark theme — app-wide Qt stylesheet.
 *
 * Derived from the "3D DCC with Modern Dark Design" Claude Design project
 * (option 1a, "Classic — Blender-style dense workspace"). Tokens used:
 *
 *   surfaces   #161618 menu/status/header   #1a1a1c bars   #1c1c1e panels
 *              #141416 inset (inputs, tracks)   #0e0e10 gaps
 *   hairlines  rgba(255,255,255, 6%) dividers   8% input borders   10% popups
 *   text       #e8e8ea primary   75% / 50% / 40% secondary, muted, section labels
 *   accent     #3d8bfd   (selection fill: 18% of accent)
 *   axes       X #ff5f56   Y #4fd671   Z #3d8bfd
 *   radii      3px controls, 4px groups     density: 11px type, 20px controls
 *
 * Kept in sync by hand with the palette in theme.cpp and the viewport
 * background in hydra_viewport_window.cpp. Dock-system (ADS) widgets need
 * their own overrides — see dock.qss for why.
 *
 * Qt stylesheets have no letter-spacing or text-transform, so the design's
 * letter-spaced uppercase section labels aren't reproduced.
 */

QWidget {
    font-family: "Inter", "Segoe UI", "Helvetica Neue", sans-serif;
    font-size: 11px;
}

QMainWindow,
QDialog {
    background: #1c1c1e;
}

QToolTip {
    background: #232326;
    color: #e8e8ea;
    border: 1px solid rgba(255, 255, 255, 10%);
    padding: 3px 6px;
}

QLabel {
    color: rgba(255, 255, 255, 55%);
}

/* ---- Menus ---------------------------------------------------------- */

QMenuBar {
    background: #161618;
    color: rgba(255, 255, 255, 65%);
    border-bottom: 1px solid rgba(255, 255, 255, 6%);
    min-height: 26px;
    padding: 0 6px;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 8px;
    margin: 2px 0;
    border-radius: 3px;
}

QMenuBar::item:selected {
    background: rgba(255, 255, 255, 10%);
    color: #e8e8ea;
}

QMenu {
    background: #1c1c1e;
    color: rgba(255, 255, 255, 75%);
    border: 1px solid rgba(255, 255, 255, 10%);
    padding: 4px;
}

QMenu::item {
    padding: 4px 24px 4px 22px;
    border-radius: 3px;
}

QMenu::item:selected {
    background: #3d8bfd;
    color: #ffffff;
}

QMenu::item:disabled {
    color: rgba(255, 255, 255, 30%);
}

QMenu::separator {
    height: 1px;
    background: rgba(255, 255, 255, 8%);
    margin: 4px 6px;
}

QMenu::indicator {
    width: 11px;
    height: 11px;
    left: 6px;
}

QMenu::indicator:non-exclusive:checked {
    image: url(:/usdcc/theme/check.png);
    background: #3d8bfd;
    border-radius: 2px;
}

/* ---- Inputs --------------------------------------------------------- */

QComboBox,
QLineEdit,
QAbstractSpinBox {
    min-height: 18px;
    padding: 0 8px;
    background: #141416;
    color: rgba(255, 255, 255, 75%);
    border: 1px solid rgba(255, 255, 255, 8%);
    border-radius: 3px;
    selection-background-color: #3d8bfd;
    selection-color: #ffffff;
}

QComboBox:hover,
QLineEdit:hover,
QAbstractSpinBox:hover {
    border-color: rgba(255, 255, 255, 18%);
}

QComboBox:focus,
QComboBox:on,
QLineEdit:focus,
QAbstractSpinBox:focus {
    border-color: #3d8bfd;
}

/* e.g. a panel's Stage dropdown while no stage is open */
QComboBox:disabled {
    color: rgba(255, 255, 255, 30%);
    background: transparent;
}

QComboBox::drop-down {
    border: none;
    width: 16px;
}

QComboBox::down-arrow {
    image: url(:/usdcc/theme/chevron-down.png);
    width: 16px;
    height: 16px;
}

QComboBox QAbstractItemView {
    background: #1c1c1e;
    color: rgba(255, 255, 255, 75%);
    border: 1px solid rgba(255, 255, 255, 10%);
    selection-background-color: #3d8bfd;
    selection-color: #ffffff;
    outline: 0;
}

QPushButton,
QToolButton {
    min-height: 18px;
    padding: 0 10px;
    background: #232326;
    color: #e8e8ea;
    border: 1px solid rgba(255, 255, 255, 8%);
    border-radius: 3px;
}

QPushButton:hover,
QToolButton:hover {
    background: #2c2c30;
}

QPushButton:pressed,
QToolButton:pressed,
QPushButton:default,
QToolButton:checked {
    background: #3d8bfd;
    border-color: #3d8bfd;
    color: #ffffff;
}

QPushButton:disabled,
QToolButton:disabled {
    color: rgba(255, 255, 255, 30%);
}

QCheckBox,
QRadioButton {
    color: rgba(255, 255, 255, 75%);
    spacing: 6px;
}

QCheckBox::indicator,
QTreeView::indicator,
QTableView::indicator,
QListView::indicator {
    width: 11px;
    height: 11px;
    background: #141416;
    border: 1px solid rgba(255, 255, 255, 18%);
    border-radius: 2px;
}

QCheckBox::indicator:checked,
QTreeView::indicator:checked,
QTableView::indicator:checked,
QListView::indicator:checked {
    background: #3d8bfd;
    border-color: #3d8bfd;
    image: url(:/usdcc/theme/check.png);
}

/* Partly checked: a tree node with only some children checked. */
QCheckBox::indicator:indeterminate,
QTreeView::indicator:indeterminate,
QTableView::indicator:indeterminate,
QListView::indicator:indeterminate {
    background: #3d8bfd;
    border-color: #3d8bfd;
    image: url(:/usdcc/theme/check-partial.png);
}

QSlider::groove:horizontal {
    height: 4px;
    background: #141416;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: #3d8bfd;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    width: 10px;
    margin: -3px 0;
    border-radius: 5px;
    background: #e8e8ea;
}

QProgressBar {
    height: 4px;
    background: #141416;
    border: none;
    border-radius: 2px;
    text-align: center;
    color: transparent;
}

QProgressBar::chunk {
    background: #3d8bfd;
    border-radius: 2px;
}

/* ---- Item views ----------------------------------------------------- */

QTreeView,
QTableView,
QListView {
    background: #1c1c1e;
    alternate-background-color: #1c1c1e;
    color: rgba(255, 255, 255, 75%);
    border: none;
    outline: 0;
    gridline-color: rgba(255, 255, 255, 6%);
    selection-background-color: rgba(61, 139, 253, 18%);
    selection-color: #ffffff;
}

QTreeView::item,
QListView::item {
    padding: 3px 6px;
    border-radius: 3px;
}

QTableView::item {
    padding: 3px 6px;
}

QTreeView::item:hover,
QListView::item:hover {
    background: rgba(255, 255, 255, 5%);
}

QTreeView::item:selected,
QListView::item:selected,
QTableView::item:selected {
    background: rgba(61, 139, 253, 18%);
    color: #ffffff;
}

QHeaderView::section {
    background: #161618;
    color: rgba(255, 255, 255, 40%);
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 6%);
    border-right: 1px solid rgba(255, 255, 255, 6%);
    padding: 4px 8px;
}

QTableCornerButton::section {
    background: #161618;
    border: none;
}

QTextEdit,
QPlainTextEdit {
    background: #141416;
    color: rgba(255, 255, 255, 75%);
    border: none;
    selection-background-color: rgba(61, 139, 253, 45%);
    selection-color: #ffffff;
}

/* ---- Scroll bars ---------------------------------------------------- */

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 15%);
    border-radius: 3px;
    min-height: 24px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: rgba(255, 255, 255, 15%);
    border-radius: 3px;
    min-width: 24px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background: rgba(255, 255, 255, 28%);
}

QScrollBar::add-line,
QScrollBar::sub-line {
    width: 0;
    height: 0;
    border: none;
    background: none;
}

QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
}

/* ---- Window furniture ----------------------------------------------- */

QStatusBar {
    background: #161618;
    color: rgba(255, 255, 255, 50%);
    border-top: 1px solid rgba(255, 255, 255, 6%);
}

QMainWindow::separator,
QSplitter::handle {
    background: #141416;
    width: 1px;
    height: 1px;
}

/* SidePanel (a plain QDockWidget, outside the ADS container). */
QDockWidget {
    color: rgba(255, 255, 255, 50%);
}

QDockWidget::title {
    background: #161618;
    padding: 5px 8px;
    text-align: left;
    border-bottom: 1px solid rgba(255, 255, 255, 6%);
}

/* ---- Custom title bar (title_bar.cpp) -------------------------------- */

QFrame#titleBar {
    background: #161618;
    border-bottom: 1px solid rgba(255, 255, 255, 6%);
}

/* The bar supplies the background and divider; the menu bar inside it must
   not draw its own. */
QFrame#titleBar QMenuBar {
    background: transparent;
    border: none;
    padding: 0;
    min-height: 0;
}

/* The items must fit inside the bar's fixed height, or the menu bar treats
   them as overflowing and hides them behind its ">>" button. */
QFrame#titleBar QMenuBar::item {
    padding: 3px 8px;
    margin: 0;
}

/* The app icon (set from code), with the design's 10px side gutters. */
QLabel#titleBarLogo {
    background: transparent;
    margin: 0 10px;
}

QLabel#titleBarTitle {
    color: rgba(255, 255, 255, 50%);
}

QLabel#titleBarTitle[active="false"] {
    color: rgba(255, 255, 255, 28%);
}

QToolButton#titleBarButton,
QToolButton#titleBarCloseButton {
    background: transparent;
    border: none;
    border-radius: 0;
    padding: 0;
    min-width: 46px;
    max-width: 46px;
}

QToolButton#titleBarButton:hover {
    background: rgba(255, 255, 255, 10%);
}

QToolButton#titleBarButton:pressed {
    background: rgba(255, 255, 255, 16%);
}

QToolButton#titleBarCloseButton:hover {
    background: #e81123;
}

QToolButton#titleBarCloseButton:pressed {
    background: #f1707a;
}

/* ---- Main-window tool rail and tool-options bar (the design's left rail
        and "tool options bar"). Both are QToolBars in the QMainWindow layout. */

/* Both bars can be dragged to other edges or floated. viewport_tool_bars.cpp
   keeps an "area" property (left/right/top/bottom/floating) up to date so the
   divider line can sit on the edge facing the content. */
QToolBar {
    background: #1a1a1c;
    border: none;
    padding: 0;
    spacing: 0;
}

QToolBar[area="left"] {
    border-right: 1px solid rgba(255, 255, 255, 6%);
}

QToolBar[area="right"] {
    border-left: 1px solid rgba(255, 255, 255, 6%);
}

QToolBar[area="top"] {
    border-bottom: 1px solid rgba(255, 255, 255, 6%);
}

QToolBar[area="bottom"] {
    border-top: 1px solid rgba(255, 255, 255, 6%);
}

QToolBar[area="floating"] {
    border: 1px solid rgba(255, 255, 255, 12%);
}

/* The drag handle: a grip of dots, oriented to the bar. */
QToolBar::handle:horizontal {
    image: url(:/usdcc/theme/grip-horizontal.png);
    width: 16px;
}

QToolBar::handle:vertical {
    image: url(:/usdcc/theme/grip-vertical.png);
    height: 16px;
}

QToolBar#toolRail {
    spacing: 6px;
}

QToolBar#toolRail:vertical {
    padding: 4px 6px;
}

QToolBar#toolRail:horizontal {
    padding: 6px 4px;
}

QToolBar#toolRail QToolButton {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 0;
    margin: 0;
    min-width: 24px;
    max-width: 24px;
    min-height: 24px;
    max-height: 24px;
}

QToolBar#toolRail QToolButton:hover {
    background: rgba(255, 255, 255, 10%);
}

QToolBar#toolRail QToolButton:checked {
    background: #3d8bfd;
}

/* The contents; the toolbar above supplies the background and divider. */
QFrame#toolOptionsBar {
    background: transparent;
    border: none;
}

QLabel#toolOptionsTitle {
    color: #e8e8ea;
    font-weight: 600;
}

QFrame#toolOptionsSeparator {
    background: rgba(255, 255, 255, 10%);
    border: none;
    min-width: 1px;
    max-width: 1px;
    min-height: 14px;
    max-height: 14px;
}

QLabel:disabled {
    color: rgba(255, 255, 255, 25%);
}

/* A row of mutually exclusive choices (the design's "Box / Lasso / Paint"
   pill group). */
QFrame#segmented {
    background: #141416;
    border-radius: 4px;
}

QToolButton#segmentButton {
    background: transparent;
    border: none;
    border-radius: 3px;
    padding: 3px 8px;
    min-height: 0;
    color: rgba(255, 255, 255, 55%);
}

QToolButton#segmentButton:hover {
    color: #e8e8ea;
}

QToolButton#segmentButton:checked {
    background: #3d8bfd;
    color: #ffffff;
}

/* The Stage/Renderer row at the top of each ViewPanel (the design's
   "tool options bar"). */
QWidget#panelToolbar {
    background: #1a1a1c;
    border-bottom: 1px solid rgba(255, 255, 255, 6%);
}

/* ViewPanel's options button: an icon-only square, not a text button. */
QToolButton#panelMenuButton {
    padding: 0;
}

/* ---- Attribute editor / property widgets ------------------------------
   (docs/ATTRIBUTE_EDITOR.md §4.2). The number fields and color chips are
   custom-painted with the same tokens (see properties/property_style.h). */

QLabel#propertyLabel {
    color: rgba(255, 255, 255, 55%);
}

/* Showing a schema fallback, nothing authored. */
QLabel#propertyLabel[unauthored="true"] {
    color: rgba(255, 255, 255, 35%);
    font-style: italic;
}

QLabel#propertyNote {
    color: rgba(255, 255, 255, 35%);
}

QLabel#propertyBadge {
    color: #3d8bfd;
    font-size: 10px;
}

/* Second line under a value: resolved asset path, connection source. */
QLabel#propertySubLine {
    color: #3d8bfd;
    font-size: 10px;
}

QLabel#propertySubLine[unresolved="true"] {
    color: #ff5f56;
}

QLabel#propertyValueText,
QLabel#propertyArraySummary {
    min-height: 18px;
    padding: 0 8px;
    background: #141416;
    color: rgba(255, 255, 255, 75%);
    border: 1px solid rgba(255, 255, 255, 8%);
    border-radius: 3px;
}

QPushButton#propertyButton,
QToolButton#propertyButton {
    padding: 0 8px;
}

QTabWidget::pane {
    border: 1px solid rgba(255, 255, 255, 6%);
    border-radius: 4px;
    top: -1px;
}

QTabBar::tab {
    background: transparent;
    color: rgba(255, 255, 255, 55%);
    padding: 5px 10px;
    border: none;
    border-bottom: 2px solid transparent;
}

QTabBar::tab:hover {
    color: #e8e8ea;
}

QTabBar::tab:selected {
    color: #e8e8ea;
    border-bottom-color: #3d8bfd;
}

/* Expand/collapse arrow (a matrix's full grid). */
QToolButton#propertyDisclosure,
QToolButton#propertyDisclosure:checked,
QToolButton#propertyDisclosure:pressed {
    background: transparent;
    border: none;
    padding: 0;
    min-width: 16px;
    max-width: 16px;
}

/* Attribute editor sections (CategorySection). */
QFrame#sectionSeparator {
    background: rgba(255, 255, 255, 6%);
}

QToolButton#sectionHeader,
QToolButton#sectionHeader:hover,
QToolButton#sectionHeader:pressed {
    background: transparent;
    border: none;
    padding: 0 2px;
    min-height: 18px;
    color: #e8e8ea;
    font-weight: 600;
}

QLabel#sectionCount {
    color: rgba(255, 255, 255, 30%);
}

/* Transform stack (TransformStackEditor) and the tool target. */
QLabel#dragHandle {
    color: rgba(255, 255, 255, 35%);
    font-size: 13px;
}

QLabel#dragHandle:hover {
    color: #e8e8ea;
}

QFrame#dropIndicator {
    background: #3d8bfd;
}

/* The op the Move/Rotate/Scale tools act on. */
QLabel#propertyLabel[target="true"] {
    color: #3d8bfd;
    font-weight: 600;
}

QCheckBox#sectionHeaderCheck {
    color: rgba(255, 255, 255, 55%);
}

QLabel#targetHint {
    color: #ffb340;
}
