<RCC>
    <qresource prefix="/usdcc/theme">
        <file alias="dark.qss">theme/dark.qss</file>
        <file alias="dock.qss">theme/dock.qss</file>
        <file alias="check.png">theme/check.png</file>
        <file alias="check@2x.png">theme/check@2x.png</file>
        <file alias="chevron-down.png">theme/chevron-down.png</file>
        <file alias="chevron-down@2x.png">theme/chevron-down@2x.png</file>
        <file alias="close.png">theme/close.png</file>
        <file alias="close@2x.png">theme/close@2x.png</file>
        <file alias="close-disabled.png">theme/close-disabled.png</file>
        <file alias="close-disabled@2x.png">theme/close-disabled@2x.png</file>
        <file alias="win-minimize.png">theme/win-minimize.png</file>
        <file alias="win-minimize@2x.png">theme/win-minimize@2x.png</file>
        <file alias="win-maximize.png">theme/win-maximize.png</file>
        <file alias="win-maximize@2x.png">theme/win-maximize@2x.png</file>
        <file alias="win-restore.png">theme/win-restore.png</file>
        <file alias="win-restore@2x.png">theme/win-restore@2x.png</file>
        <file alias="win-close.png">theme/win-close.png</file>
        <file alias="win-close@2x.png">theme/win-close@2x.png</file>
        <file alias="win-close-hover.png">theme/win-close-hover.png</file>
        <file alias="win-close-hover@2x.png">theme/win-close-hover@2x.png</file>
        <file alias="detach.png">theme/detach.png</file>
        <file alias="detach@2x.png">theme/detach@2x.png</file>
        <file alias="detach-disabled.png">theme/detach-disabled.png</file>
        <file alias="detach-disabled@2x.png">theme/detach-disabled@2x.png</file>
    </qresource>
    <qresource prefix="/usdcc/app">
        <file alias="icon-16.png">app-icon/usdcc-16.png</file>
        <file alias="icon-24.png">app-icon/usdcc-24.png</file>
        <file alias="icon-32.png">app-icon/usdcc-32.png</file>
        <file alias="icon-48.png">app-icon/usdcc-48.png</file>
        <file alias="icon-64.png">app-icon/usdcc-64.png</file>
        <file alias="icon-128.png">app-icon/usdcc-128.png</file>
        <file alias="icon-256.png">app-icon/usdcc-256.png</file>
    </qresource>
</RCC>
