# Writes usdcc's version source (cmake/modules/UsdccVersion.cmake), run with -P
# at every build. Rewrites OUTPUT only when its content changes.
#
# Inputs: OUTPUT, SOURCE_DIR, GIT_EXECUTABLE (may be empty), RELEASE (the
# release's version, empty for a development build), NUMBER (the configure-time
# release number).
#
# A development build is named after the last release: 0.2.0+5.3b70ef2 is 5
# commits after v0.2.0, at commit 3b70ef2, and 0.2.0+5.3b70ef2.dirty has
# changed files too. Without a tag it's 0.0.0+3b70ef2.

set(commit "")
set(described "")
if(GIT_EXECUTABLE)
    execute_process(
        COMMAND "${GIT_EXECUTABLE}" rev-parse --short=7 HEAD
        WORKING_DIRECTORY "${SOURCE_DIR}"
        OUTPUT_VARIABLE commit
        RESULT_VARIABLE result
        OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(NOT result EQUAL 0)
        set(commit "")
    endif()
    execute_process(
        COMMAND "${GIT_EXECUTABLE}" describe --tags --long --dirty --abbrev=7 --match "v[0-9]*"
        WORKING_DIRECTORY "${SOURCE_DIR}"
        OUTPUT_VARIABLE described
        RESULT_VARIABLE result
        OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(NOT result EQUAL 0)
        set(described "")
    endif()
endif()

if(RELEASE)
    set(version "${RELEASE}")
    set(is_release "true")
else()
    set(is_release "false")
    set(dirty "")
    if(described MATCHES "-dirty$")
        set(dirty ".dirty")
    elseif(NOT described AND commit AND GIT_EXECUTABLE)
        # No tag to describe from: ask about changed files directly.
        execute_process(
            COMMAND "${GIT_EXECUTABLE}" diff-index --quiet HEAD --
            WORKING_DIRECTORY "${SOURCE_DIR}"
            RESULT_VARIABLE changed
            ERROR_QUIET)
        if(changed EQUAL 1)
            set(dirty ".dirty")
        endif()
    endif()
    if(described MATCHES "^v(.+)-([0-9]+)-g([0-9a-f]+)(-dirty)?$")
        set(version "${CMAKE_MATCH_1}+${CMAKE_MATCH_2}.${CMAKE_MATCH_3}${dirty}")
    elseif(commit)
        set(version "${NUMBER}+${commit}${dirty}")
    else()
        set(version "${NUMBER}+unknown")
    endif()
endif()

string(TIMESTAMP build_date "%Y-%m-%d" UTC)

set(content "// Generated by cmake/scripts/write_version.cmake at build time. Don't edit.
#include \"usdcc/core/version.h\"

namespace usdcc::core {

const char* version() { return \"${version}\"; }
const char* releaseNumber() { return \"${NUMBER}\"; }
bool isReleaseBuild() { return ${is_release}; }
const char* commit() { return \"${commit}\"; }
const char* buildDate() { return \"${build_date}\"; }

}  // namespace usdcc::core
")

set(existing "")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" existing)
endif()
if(NOT existing STREQUAL content)
    file(WRITE "${OUTPUT}" "${content}")
endif()
